# IntelliAssist AI - Environment Configuration Example
# Copy this file to .env and configure settings as needed for future integrations

# Application Settings
APP_NAME=IntelliAssist AI
APP_ENV=development
DEBUG=True

# Embedding Settings (Hugging Face Sentence Transformers)
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
NORMALIZE_EMBEDDINGS=True

# Search & Retrieval Settings
DEFAULT_TOP_K=4

# Document Processing Settings
DEFAULT_CHUNK_SIZE=1000
DEFAULT_CHUNK_OVERLAP=200
MAX_UPLOAD_SIZE_MB=25

# LLM & RAG Settings (Google Gemini)
LLM_PROVIDER=gemini
LLM_MODEL_NAME=gemini-1.5-flash
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=1024
MIN_SIMILARITY_THRESHOLD=0.20

# Google Gemini API Key (Required for RAG answers)
# Get your API key from Google AI Studio (https://aistudio.google.com/)
GOOGLE_API_KEY=your_google_api_key_here

